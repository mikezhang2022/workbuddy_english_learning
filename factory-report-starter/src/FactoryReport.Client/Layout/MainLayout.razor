@inherits LayoutComponentBase
@inject IAuthSessionService AuthSession

<MudLayout Class="app-shell">
    <MudAppBar Elevation="1" Dense="true" Class="app-top-bar">
        <MudText Typo="Typo.h6">工厂报表</MudText>
        <MudSpacer />
        @if (AuthSession.CurrentUser is not null)
        {
            <MudText Typo="Typo.body2" Class="d-none d-sm-inline user-chip">
                @AuthSession.CurrentUser.DisplayName
            </MudText>
        }
    </MudAppBar>

    <MudMainContent Class="app-main">
        <OfflineBanner />
        <div class="app-content">
            @Body
        </div>
    </MudMainContent>

    <MobileBottomNav />
</MudLayout>
