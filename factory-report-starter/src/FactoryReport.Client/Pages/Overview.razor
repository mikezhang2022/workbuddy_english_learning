@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IAuthSessionService AuthSession
@inject IOnlineStatusService OnlineStatus

<PageTitle>概览 - 工厂报表</PageTitle>

<h1 class="visually-hidden">概览</h1>

<MudText Typo="Typo.h6" GutterBottom="true">欢迎，@(AuthSession.CurrentUser?.DisplayName ?? "用户")</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.subtitle2">当前账号</MudText>
    <MudText Typo="Typo.body2">@AuthSession.CurrentUser?.UserName</MudText>
    @if (AuthSession.CurrentUser?.Roles is { Count: > 0 } roles)
    {
        <MudText Typo="Typo.caption" Class="mt-2">角色：@string.Join("、", roles)</MudText>
    }
    <MudDivider Class="my-3" />
    <MudText Typo="Typo.subtitle2">数据范围（服务端授权摘要）</MudText>
    @foreach (var line in DataScopeDisplayFormatter.FormatSummaryLines(AuthSession.CurrentUser?.DataScope))
    {
        <MudText Typo="Typo.body2">@line</MudText>
    }
</MudPaper>

@if (!OnlineStatus.IsOnline)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        @ApiConstants.OfflineDataMessage
    </MudAlert>
}

<MudText Typo="Typo.subtitle1" Class="mb-2">报表列表</MudText>
<MudText Typo="Typo.body2" Class="mb-3">
    选择下方报表进入查询。数据需联网从 API 获取；当前为演示数据 / Fake。
</MudText>

<div class="report-list">
    @foreach (var item in ReportLinks)
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Href="@item.Href"
                   Class="report-list-item mb-2"
                   StartIcon="@item.Icon">
            @item.Title
        </MudButton>
    }
</div>

@code {
    private sealed record ReportLink(string Href, string Title, string Icon);

    private static readonly ReportLink[] ReportLinks =
    [
        new("/reports/production-daily", "生产日报", Icons.Material.Filled.Today),
        new("/reports/work-order-progress", "工单进度", Icons.Material.Filled.Assignment),
        new("/reports/quality-statistics", "质量统计", Icons.Material.Filled.FactCheck),
        new("/reports/production-plan-achievement", "计划达成", Icons.Material.Filled.TrendingUp),
        new("/reports/monthly-production-plan", "月度生产计划", Icons.Material.Filled.CalendarMonth)
    ];
}
