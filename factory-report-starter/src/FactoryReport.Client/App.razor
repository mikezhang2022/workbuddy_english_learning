@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthSessionService AuthSession
@inject IOnlineStatusService OnlineStatus

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    @if (!_ready)
    {
        @if (!string.IsNullOrEmpty(_initError))
        {
            <MudPaper Class="pa-6 ma-4" Elevation="0">
                <MudText Typo="Typo.h6" Color="Color.Error">应用初始化失败</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">@_initError</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="RetryInitializeAsync">
                    重试
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="app-boot-progress" />
        }
    }
    else
    {
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <ReportForbidden />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    }
</CascadingAuthenticationState>

@code {
    private bool _ready;
    private string? _initError;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1f3a4d",
            AppbarBackground = "#1f3a4d"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await InitializeAppAsync();
    }

    private async Task RetryInitializeAsync()
    {
        await InitializeAppAsync();
    }

    private async Task InitializeAppAsync()
    {
        _initError = null;
        _ready = false;
        try
        {
            await OnlineStatus.InitializeAsync();
            await AuthSession.InitializeAsync();
            _ready = true;
        }
        catch (Exception ex)
        {
            _initError = string.IsNullOrWhiteSpace(ex.Message)
                ? "初始化过程中发生未知错误。"
                : ex.Message;
            _ready = false;
        }
    }
}
