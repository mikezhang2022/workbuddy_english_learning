@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthSessionService AuthSession
@inject IOnlineStatusService OnlineStatus

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    @if (!_ready)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="app-boot-progress" />
    }
    else
    {
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <ReportForbidden />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    }
</CascadingAuthenticationState>

@code {
    private bool _ready;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1f3a4d",
            AppbarBackground = "#1f3a4d"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await OnlineStatus.InitializeAsync();
        await AuthSession.InitializeAsync();
        _ready = true;
    }
}
