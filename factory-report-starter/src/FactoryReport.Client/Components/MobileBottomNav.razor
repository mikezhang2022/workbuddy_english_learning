@inject NavigationManager Navigation

<MudPaper Class="bottom-nav" Elevation="8">
    <MudToolBar Class="bottom-nav-toolbar">
        @foreach (var item in NavItems)
        {
            var active = IsActive(item.Href);
            <MudButton Variant="@(active ? Variant.Filled : Variant.Text)"
                       Color="@(active ? Color.Primary : Color.Inherit)"
                       Class="bottom-nav-item"
                       Href="@item.Href"
                       aria-current="@(active ? "page" : null)"
                       aria-label="@item.Label">
                <MudIcon Icon="@item.Icon" />
                <span class="bottom-nav-label">@item.ShortLabel</span>
            </MudButton>
        }
    </MudToolBar>
</MudPaper>

@code {
    private sealed record NavItem(string Href, string Label, string ShortLabel, string Icon);

    private static readonly NavItem[] NavItems =
    [
        new("/", "概览", "概览", Icons.Material.Filled.Home),
        new("/reports/production-daily", "生产日报", "日报", Icons.Material.Filled.Today),
        new("/reports/work-order-progress", "工单进度", "工单", Icons.Material.Filled.Assignment),
        new("/reports/quality-statistics", "质量统计", "质量", Icons.Material.Filled.FactCheck),
        new("/reports/production-plan-achievement", "计划达成", "达成", Icons.Material.Filled.TrendingUp),
        new("/reports/monthly-production-plan", "月度计划", "月计划", Icons.Material.Filled.CalendarMonth),
        new("/account", "我的账号", "我的", Icons.Material.Filled.Person)
    ];

    private bool IsActive(string href)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (href == "/")
        {
            return string.IsNullOrEmpty(relative) || relative == "/";
        }

        return relative.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }
}
